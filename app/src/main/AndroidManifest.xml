<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <application
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher_vsv"
    android:label="@string/app_name"
    android:roundIcon="@mipmap/ic_launcher_vsv_round"
    android:supportsRtl="true"
    android:theme="@style/Theme.A6Assignments"
    tools:targetApi="31">
    <activity
      android:exported="false"
      android:name=".activities.SignIn" />
    <activity
      android:exported="false"
      android:name=".activities.AboutGroup" />
    <activity
      android:exported="false"
      android:name=".activities.RecipeListReportActivity" />
    <activity
      android:exported="false"
      android:name=".activities.FoodRecipeRequestActivity" />
    <activity
      android:exported="true"
      android:name=".activities.MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>

  <uses-permission android:name="android.permission.INTERNET" />

</manifest>