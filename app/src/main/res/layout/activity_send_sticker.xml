<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".activities.SendStickerActivity">

  <TextView
    android:id="@+id/sendStickerTitle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/send_sticker"
    android:textSize="24sp"
    android:textStyle="bold"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="48dp" />

  <ScrollView
    android:id="@+id/scrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    app:layout_constraintTop_toBottomOf="@id/sendStickerTitle"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="18dp"
    android:layout_marginStart="44dp"
    android:layout_marginEnd="44dp">

    <LinearLayout
      android:id="@+id/sticker_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <Button
        android:id="@+id/btnSelectSticker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/select_sticker"
        android:background="@drawable/button_outline"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:enabled="false"
        android:textColor="@color/black"
        android:alpha="0.6" />

      <GridLayout
        android:id="@+id/gridStickers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp">

        <!-- Sticker 1 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker1" />

        </FrameLayout>

        <!-- Sticker 2 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker2" />

        </FrameLayout>

        <!-- Sticker 3 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker3" />

        </FrameLayout>

        <!-- Sticker 4 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker4" />

        </FrameLayout>

        <!-- Sticker 5 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker5" />

        </FrameLayout>

        <!-- Sticker 6 Container -->
        <FrameLayout
          android:layout_width="130dp"
          android:layout_height="130dp"
          android:layout_margin="8dp">

          <ImageView
            android:id="@+id/stickerOption6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sticker_selector"
            android:scaleType="centerInside"
            android:src="@drawable/ic_placeholder"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:tag="sticker6" />

        </FrameLayout>

      </GridLayout>

      <!-- Select User Dropdown -->
      <Spinner
        android:id="@+id/spinnerSelectUser"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/button_outline"
        android:prompt="@string/select_user_prompt"
        android:layout_marginBottom="34dp"/>

      <!-- Send Button -->
      <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerSelectUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </LinearLayout>

  </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>