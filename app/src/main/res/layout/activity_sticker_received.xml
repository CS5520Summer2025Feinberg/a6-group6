<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".activities.StickerReceivedActivity">

  <!-- Guideline for top margin -->
  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline_top"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.05" />

  <!-- Guideline for left margin -->
  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline_start"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.04" />

  <!-- Guideline for right margin -->
  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline_end"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      app:layout_constraintGuide_percent="0.96" />

  <!-- Guideline for bottom margin -->
  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline_bottom"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.95" />

  <!-- Header Section -->
  <TextView
      android:id="@+id/textViewTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="Received Stickers"
      android:textSize="24sp"
      android:textStyle="bold"
      android:textColor="@color/primary_text_color"
      android:gravity="center"
      android:padding="16dp"
      app:layout_constraintTop_toTopOf="@id/guideline_top"
      app:layout_constraintStart_toStartOf="@id/guideline_start"
      app:layout_constraintEnd_toEndOf="@id/guideline_end" />

  <!-- Guideline for content separation -->
  <androidx.constraintlayout.widget.Guideline
      android:id="@+id/guideline_content_top"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      app:layout_constraintGuide_percent="0.12" />

  <!-- Swipe Refresh Layout containing RecyclerView -->
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
      android:id="@+id/swipeRefreshLayout"
      android:layout_width="0dp"
      android:layout_height="0dp"
      app:layout_constraintTop_toTopOf="@id/guideline_content_top"
      app:layout_constraintStart_toStartOf="@id/guideline_start"
      app:layout_constraintEnd_toEndOf="@id/guideline_end"
      app:layout_constraintBottom_toTopOf="@id/guideline_bottom">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewReceivedStickers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_received_sticker" />

  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  <!-- Empty State (shown when no stickers received) -->
  <LinearLayout
      android:id="@+id/linearLayoutEmptyState"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="center"
      android:visibility="gone"
      app:layout_constraintTop_toTopOf="@id/guideline_content_top"
      app:layout_constraintBottom_toTopOf="@id/guideline_bottom"
      app:layout_constraintStart_toStartOf="@id/guideline_start"
      app:layout_constraintEnd_toEndOf="@id/guideline_end">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_sticker_placeholder"
        android:alpha="0.3"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No stickers received yet"
        android:textSize="18sp"
        android:textColor="@color/secondary_text_color"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pull down to refresh"
        android:textSize="14sp"
        android:textColor="@color/secondary_text_color"
        android:alpha="0.7" />

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>